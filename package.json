{
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "pnpm --filter app dev",
    "watch": "pnpm -r --parallel --filter svgcanvas --filter msa-parsers --filter react-msaview --filter app run '/^(watch|dev)$/'",
    "build": "pnpm --filter svgcanvas build && pnpm --filter msa-parsers build && pnpm --filter react-msaview build",
    "sync:r-bundle": "node scripts/sync-r-bundle.mjs",
    "build:lib": "pnpm --filter svgcanvas build && pnpm --filter msa-parsers build && pnpm --filter react-msaview build:esm",
    "build:site": "pnpm --filter website build",
    "build:pages": "pnpm build:lib && pnpm build:site && pnpm --filter app build && node scripts/assemble-pages.mjs",
    "deploy:pages": "pnpm build:pages && gh-pages -d pages-dist -t",
    "clean": "pnpm -r run clean",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings",
    "lint:fast": "oxlint -c .oxlintrc.json --deny-warnings",
    "format": "oxfmt . && prettier --write \"website/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"website/**/*.astro\"",
    "test": "vitest",
    "figures": "vitest run --config vitest.figures.config.ts",
    "examples:gen": "node scripts/examples-gen/generate.mjs",
    "screenshots": "node scripts/screenshots/writeExampleData.mjs && pnpm --filter app exec vite build && node scripts/screenshots/generate.mjs",
    "screenshots:all": "node scripts/screenshots/generate-screenshots.mjs",
    "screenshots:jbrowse": "node scripts/screenshots/jbrowse-figures.mjs",
    "typecheck": "pnpm -r --filter=!website exec tsc --noEmit && pnpm --filter website exec astro sync && pnpm --filter website exec tsc --noEmit",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "attw": "pnpm -r --filter react-msaview --filter msa-parsers --filter @jbrowse/svgcanvas exec attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@emotion/react": "^11.14.0",
    "@jbrowse/core": "file:vendor-jbrowse/jbrowse-core.tgz",
    "@jbrowse/mobx-state-tree": "^6.0.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "flatbush": "^4.6.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "mobx": "^7.0.0",
    "mobx-react": "^10.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "serve-handler": "^6.1.7",
    "slugify": "^1.6.9",
    "tss-react": "^4.9.21",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
