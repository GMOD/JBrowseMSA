---
import Viewer from './Viewer.tsx'

const base = import.meta.env.BASE_URL
---

<div class="frame">
  <Viewer client:only="react" base={base} />
</div>
<p>
  Twelve NLRP1 orthologs, their InterPro domains overlaid, and the inferred tree
  beside them. The view opens on the NACHT domain, which every row carries. The
  shared core domains sit up to 391 residues apart between rows and still land
  in the same columns, because the overlay places a domain by alignment column.
  Drag the alignment to scroll, and the minimap along the top marks where the
  columns on screen sit in all 1,666.
</p>

<style>
  .frame {
    border: 1px solid var(--border);
  }
</style>
