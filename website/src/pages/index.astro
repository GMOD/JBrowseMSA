---
import Viewer from '../components/Viewer.tsx'
import Base from '../layouts/Base.astro'

const base = import.meta.env.BASE_URL
const formats = [
  {
    what: 'Alignment',
    formats:
      'FASTA (gaps already inserted), Stockholm (.stock, may carry its own tree and secondary structure), Clustal (.aln), A3M, EMF',
  },
  {
    what: 'Tree',
    formats: 'Newick (.nh), or the tree embedded in a Stockholm or EMF file',
  },
  {
    what: 'Annotations',
    formats:
      'GFF3 (InterProScan domains, exon and gene models, anything with per-row coordinates), or InterProScan JSON',
  },
]
const steps = [
  {
    n: '1',
    title: 'Open your files',
    body: 'Alignment, tree and annotations, from your computer or a URL. Nothing is uploaded: the parsing and drawing happen in your browser.',
    cards: [
      {
        title: 'Standalone app',
        body: 'Open your own files and explore them.',
        href: `${base}/demo/`,
        cta: true,
      },
      {
        title: 'User guide',
        body: 'A tour of the viewer: navigation, color schemes, tracks, exporting, and sharing a link to a view.',
        href: `${base}/guide`,
      },
      {
        title: 'Gallery',
        body: 'Alignments that carry a finding, each one a link that opens it.',
        href: `${base}/gallery`,
      },
    ],
  },
  {
    n: '2',
    title: 'Build the files',
    body: 'A handful of commands take sequences to an alignment, a tree and annotations for the viewer to open.',
    cards: [
      {
        title: 'Tutorials',
        body: 'Start-to-finish walkthroughs ending on a link that opens the result.',
        href: `${base}/tutorials`,
      },
      {
        title: 'CLI',
        body: 'Domain and exon GFFs from InterPro, InterProScan or RefSeq, and headless SVG export.',
        href: `${base}/cli`,
      },
    ],
  },
  {
    n: '3',
    title: 'Put it in your own page',
    body: 'Embed the viewer the app runs as a React component, a script tag or an R call.',
    cards: [
      {
        title: 'Embedding',
        body: 'Props, the model API, and the UMD bundle.',
        href: `${base}/embedding`,
      },
      {
        title: 'Examples',
        body: 'A live gallery of usage patterns, with the source of each.',
        href: `${base}/examples`,
      },
      {
        title: 'Layers',
        body: 'Highlights, data tracks and structure mappings you compute, carried in the snapshot for the viewer to draw.',
        href: `${base}/layers`,
      },
      {
        title: 'R package (msaviewr)',
        body: 'ape, Biostrings, ggtree, treeio, and Shiny interop.',
        href: `${base}/r-package`,
      },
    ],
  },
]
---

<Base
  title="JBrowseMSA — multiple sequence alignment viewer"
  description="Interactive multiple sequence alignment viewer with phylogenetic tree, protein domains, and many color schemes. React, HTML, and R."
  wide
>
  <section class="hero">
    <h1>JBrowseMSA</h1>
    <p class="tagline">
      An interactive multiple sequence alignment viewer with a phylogenetic
      tree, protein domains and many color schemes, scaling to alignments of
      tens of thousands of rows. Everything runs in the browser; nothing is
      uploaded.
    </p>
  </section>

  <section class="embed">
    <h2>Try it</h2>
    <Viewer client:only="react" base={base} />
  </section>

  {steps.map(step => (
    <section class="step">
      <h2>
        <span class="step-n">{step.n}</span>
        {step.title}
      </h2>
      <p class="step-body">{step.body}</p>
      <div class="cards">
        {step.cards.map(card => (
          <a class:list={['card', { primary: card.cta }]} href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </a>
        ))}
      </div>
      {step.n === '1' && (
        <table class="formats">
          <thead>
            <tr>
              <th>Input</th>
              <th>Formats it reads</th>
            </tr>
          </thead>
          <tbody>
            {formats.map(row => (
              <tr>
                <th scope="row">{row.what}</th>
                <td>{row.formats}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  ))}
</Base>
