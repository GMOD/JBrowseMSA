{
  "name": "react-msaview",
  "author": "Colin",
  "version": "6.1.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/JBrowseMSA.git",
    "directory": "packages/lib"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "types": "src/index.ts",
  "files": [
    "dist",
    "bundle",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "clean": "rimraf dist bundle",
    "watch": "pnpm build:esm --watch",
    "format": "prettier --write .",
    "build:esm": "tsc --project tsconfig.build.json",
    "build:umd": "node esbuild.mjs",
    "build": "pnpm clean && pnpm build:esm && pnpm build:umd",
    "statedocs": "node --experimental-strip-types docgen/generateStateModelDocs.ts",
    "poststatedocs": "oxfmt apidocs",
    "test": "vitest"
  },
  "peerDependencies": {
    "@jbrowse/core": ">=2.0.0",
    "@jbrowse/mobx-state-tree": "^6.0.0",
    "@mui/icons-material": ">=5.0.0",
    "@mui/material": ">=5.0.0",
    "mobx": ">=7.0.0",
    "mobx-react": ">=9.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "dist/index.d.ts",
    "main": "dist/index.js"
  },
  "devDependencies": {
    "@jbrowse/core": "file:vendor-jbrowse/jbrowse-core.tgz",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@gmod/newick": "^1.0.0",
    "@jbrowse/svgcanvas": "workspace:*",
    "colord": "^2.9.3",
    "flatbush": "^4.6.2",
    "msa-parsers": "workspace:*"
  }
}
