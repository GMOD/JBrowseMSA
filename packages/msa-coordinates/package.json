{
  "name": "msa-coordinates",
  "version": "10.1.1",
  "description": "Convert between a multiple sequence alignment's columns, the columns left once some are hidden, and each row's own residue positions",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/JBrowseMSA.git",
    "directory": "packages/msa-coordinates"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "watch": "tsc --project tsconfig.build.json --watch",
    "test": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "dist/index.d.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
