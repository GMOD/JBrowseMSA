---
import Base from '../layouts/Base.astro'
import Figure from '../components/Figure.astro'
import JBrowseFigure from '../components/JBrowseFigure.astro'
import { f12CombinedCloseupUrl } from '../lib/f12CombinedLinks'
import {
  brafV600,
  proteinLinked,
  tp53PhmmerRp15,
  tp53Protein3d,
  tp53R248,
  tp53UnirefBrowser,
} from '../lib/jbrowseLinks'

const base = import.meta.env.BASE_URL

// Standalone react-msaview figures — just an alignment, a tree, and optional
// feature overlays, no genome browser. Generated by scripts/screenshots
// (specs.mjs). Each tells one biological story that reads straight off the
// picture.
// One figure per distinct viewer capability rather than per interesting
// organism — the standalone demo app at /examples carries the full set of
// biological stories. Each entry here shows something the others don't:
// feature overlays, domain annotation, reference diffing, data layers and
// labeled bands, tree topology, RNA secondary structure, base-pair arcs, gene
// arrows, base-resolution DNA, scale.
const figures = [
  {
    src: 'real-domains.png',
    title: 'Domain architecture',
    body: 'The Src-family kinases with InterProScan annotations: the shared SH3 + SH2 + kinase domain blocks line up down every member, so the family’s domain layout reads straight across the alignment.',
  },
  {
    src: 'domain-contacts.png',
    title: 'How the domains pack',
    body: 'The same Src-family kinases, with a contact map from the solved structure over the domain boxes. The boxes say the family is SH3 + SH2 + kinase; the arcs say how those three fold against each other, which is the mechanism — the C-terminal tail doubles back so its phospho-Tyr527 binds the protein’s own SH2 domain (red) and clamps the kinase shut. C-beta pairs under 8 Å in PDB 2SRC, mapped to UniProt numbering through SIFTS, filtered to the pairs joining two different domains, and placed on the human row so the viewer projects them onto the alignment’s columns.',
  },
  {
    src: 'within-protein-conservation.png',
    title: 'A dominant functional domain',
    body: 'p53’s InterProScan domains overlaid: the central DNA-binding domain (red) — where most cancer mutations cluster — forms the bulk of the protein, flanked by the short N-terminal transactivation motifs. The overlay maps the functional architecture onto the alignment.',
  },
  {
    src: 'clinvar-variants.png',
    title: 'A layer the alignment cannot know',
    body: 'The same p53 orthologs, diffed against human, with two labeled bands and one track that came from somewhere else entirely: the missense variants ClinVar classifies as pathogenic, counted per residue. 94% of them fall inside the DNA-binding domain, and the small second cluster sits on the tetramerization motif. Conservation is computed from the alignment and says where this family has not changed; this says where changing it causes disease, and the viewer computes none of it — the counts arrive as data and are drawn on the human row’s residues.',
  },
  {
    src: 'domain-loss.png',
    title: 'Domain loss across orthologs',
    body: 'Twelve NLRP1 orthologs. Every row carries the same core — NACHT, winged helix, HD2, then FIIND/UPA and the CARD — and every one of those blocks lines up in the same columns. The N-terminal PYD (cyan) is there in only five rows, so the blank space under it is a module the other seven lack. Those core domains sit up to 391 residues apart between rows in their own coordinates; column-locking is what stacks them.',
  },
  {
    src: 'column-lock.png',
    title: 'Why the domain overlay is column-locked',
    body: 'The same twelve NLRP1 orthologs, the same domain GFF, the same palette and tree — the only difference is whether the input was aligned. Unaligned (top), column N is residue N and the shared domains scatter into a staircase. Aligned (bottom), they land in the same columns: NACHT starts at residue 328 in human and 93 in hamster, and both are drawn within one column of each other.',
  },
  {
    src: 'extreme-conservation.png',
    title: 'Reference comparison (dots)',
    body: 'Diffing against a reference (relativeTo) collapses identical residues to dots so only the changes stand out. Histone H4, one of the most conserved proteins known, is almost entirely dots relative to human — only the most distant lineages differ.',
  },
  {
    src: 'processing-conservation.png',
    title: 'Post-translational processing',
    body: 'Insulin relative to human: the mature B and A chains stay conserved (dots) while the cleaved-out C-peptide drifts (letters) — the same dot-diffing reading out where a protein is under selection.',
  },
  {
    src: 'gene-duplication.png',
    title: 'Gene duplication',
    body: 'The globin family groups by globin type across species rather than by species — alpha beside alpha, beta beside beta — the signature of ancient gene duplication read off the tree.',
  },
  {
    src: 'tree-of-life.png',
    title: 'Tree of life',
    body: 'Elongation factor EF-1α/EF-Tu across bacteria, archaea, and eukaryotes — the label prefixes make the three domains of life read straight off a single inferred tree.',
  },
  {
    src: 'rna-secondary-structure.png',
    title: 'RNA secondary structure',
    body: 'A tRNA alignment (Rfam RF00005): the Stockholm SS_cons cloverleaf renders as a dedicated secondary-structure track above the columns, with the acceptor stem and D-/anticodon-/T-arms colored by base-pairing.',
  },
  {
    src: 'pseudoknot-arcs.png',
    title: 'Base pairs, including a pseudoknot',
    body: 'The coronavirus frameshifting stimulation element (Rfam RF00507) across all four genera. The Base pairs track draws the Stockholm SS_cons as arcs between the columns that pair: blue for the nested helices, red for the pseudoknot. A pseudoknot is by definition a pair that crosses a helix instead of nesting inside it, which is why WUSS has to write it as the letter pair A/a and why the bracket track directly above shows two runs of letters with no visible relationship. The arcs cross.',
  },
  {
    src: 'f12-exon-architecture.png',
    title: 'Gene structure overlay (DNA)',
    body: 'Coagulation factor XII coding alignment with its 14 exons overlaid — each exon the same color across species, through the same overlay path as InterProScan domains (built by react-msaview-cli genestructure). The whole gene’s exon architecture reads straight down the alignment.',
  },
  {
    src: 'f12-frameshift.png',
    title: 'Pseudogenization (base resolution)',
    body: 'Zoomed to single nucleotides: F12 is intact in land mammals and the manatee, but a single-base deletion shared by exactly the four cetaceans — beside premature stops elsewhere — disables it. Gene loss visible at the base level, which a protein alignment cannot show.',
  },
  {
    src: 'gene-arrow-map.png',
    title: 'Gene-arrow map',
    body: 'A gggenes-style gene cluster across genomes, each gene a strand-directed arrow anchored to alignment columns: one gene is inverted (the arrow flips) and one deleted (its columns gap out), yet every gene stays column-aligned.',
  },
  {
    src: 'large-tree.png',
    title: 'Scale',
    body: 'A real ~60-sequence lysine-riboswitch family and its full inferred tree, rendered through the tiled canvas system that keeps large alignments responsive.',
  },
]
---

<Base
  title="Gallery — JBrowseMSA"
  description="A gallery of react-msaview: alignments that tell a biological story on their own, and connected JBrowse sessions linking genome, alignment, and 3D structure."
  wide
>
  <article class="prose">
    <h1>Gallery</h1>
    <p>
      Two kinds of example: the standalone react-msaview viewer, where the
      biology reads straight off the alignment and tree, and react-msaview
      running inside JBrowse, connected to a genome view and 3D structure. Each
      is built reproducibly from public data by the scripts in the repo.
    </p>

    <h2 id="standalone">Standalone react-msaview</h2>
    <p>
      Just an alignment, a tree, and optional feature overlays — no genome
      browser. Each figure below shows a distinct viewer capability — domain
      overlays, reference diffing, data layers, tree topology, RNA secondary
      structure, base-pair arcs, gene arrows, base-resolution DNA, scale. The
      full set of biological examples (more conservation, phylogeny, and domain
      stories) is live and interactive on the
      <a href={`${base}/examples`}>examples</a> page.
    </p>

    {
      figures.map(f => (
        <Figure src={f.src} alt={f.body}>
          <strong>{f.title}</strong> — {f.body}
        </Figure>
      ))
    }

    <h2 id="jbrowse">Inside JBrowse</h2>
    <p>
      react-msaview also runs as a
      <a href="https://github.com/GMOD/jbrowse-plugin-msaview"
        >JBrowse 2 plugin</a
      >: the alignment and tree open <em>inside</em> JBrowse, connected to a genome
      view and — with
      <a href="https://github.com/GMOD/jbrowse-plugin-protein3d">protein3d</a> — the
      AlphaFold structure. Selecting a region in any view lights the matching columns,
      codons, and residues in the others. Each example below is one declarative URL.
    </p>

    <JBrowseFigure
      src="f12-combined-closeup.png"
      href={f12CombinedCloseupUrl}
      alt="A single JBrowse session at base resolution over F12 exon 3: the RefSeq gene annotation track on top and the react-msaview DNA alignment with its species tree below, the four cetaceans showing a gap where every other mammal has a C — the shared single-base frameshift — with the highlighted column linking the genome to the alignment"
      body="Genome ↔ alignment in one JBrowse session: the F12 locus (RefSeq annotation, top) over the react-msaview DNA alignment + species tree, zoomed to base resolution at exon 3. The highlighted column ties the genome to the alignment — the four cetaceans carry a single-base deletion (a gap where every other mammal has a C) that disables the gene. This is the viewer an MSA editor would build on: the 14-exon model is already registered to the alignment columns and lifted onto each species."
    />

    <JBrowseFigure
      src="genome-browser-tp53-protein3d.png"
      href={tp53Protein3d}
      alt="JBrowse: the TP53 gene with ClinVar, the p53 ortholog alignment, and the AlphaFold structure, all connected, with the nuclear export signal motif lit across genome, alignment, and 3D structure"
      body="Genome ↔ alignment ↔ 3D structure: the TP53 gene (RefSeq + ClinVar), the p53 ortholog alignment, and the AlphaFold structure as one connected session, opened with the nuclear export signal motif (residues 339–350) lit across all three — the same motif highlighted on the genome, the alignment column, and the folded structure at once."
    />

    <p>The same connected pattern without the structure view:</p>
    <ul>
      <li>
        <a href={proteinLinked} target="_blank" rel="noopener">SRC ↗</a> — the Src-family
        kinase alignment beside the SRC gene.
      </li>
      <li>
        <a href={brafV600} target="_blank" rel="noopener">BRAF V600E ↗</a> — the RAF
        family on the invariant V600 codon, with a ClinVar pathogenic-variant track.
      </li>
      <li>
        <a href={tp53R248} target="_blank" rel="noopener">TP53 R248 ↗</a> — p53 across
        vertebrates on the R248 hotspot, with ClinVar.
      </li>
    </ul>

    <p>
      The links above carry their alignments as files. The two below carry a
      <em>request</em> instead, and the view builds the alignment when it opens: the
      spec names the transcript (<code>connectedTranscript</code>) and the
      plugin looks its exon model up in the genome view's gene track, so the
      whole session is a URL short enough to type.
    </p>
    <ul>
      <li>
        <a href={tp53UnirefBrowser} target="_blank" rel="noopener"
          >TP53 UniRef cluster ↗</a
        > — every reference-proteome protein in UniProtKB within 50% identity of p53,
        looked up from UniProt and aligned to the transcript in the browser. No job
        at any service, so it opens in seconds.
      </li>
      <li>
        <a href={tp53PhmmerRp15} target="_blank" rel="noopener"
          >TP53 phmmer search ↗</a
        > — the same gene through a phmmer search of UniProt's representative proteomes
        at 15% similarity, the widest net EBI offers: p53's relatives across the tree
        of life. The wait is EBI's queue, from seconds to many minutes.
      </li>
    </ul>

    <h2 id="embedded">Or one panel, in a page you write</h2>
    <p>
      A connected session is the most a reader can be handed and also the most
      they have to take in: three linked views, each with its own tracks, menus
      and coordinate system. When a page has one question to answer, the other
      shape is to embed the viewer alone and put only the controls that question
      needs around it — the alignment without the genome browser, the tree
      turned off when there is no meaningful tree, a diff toggle and an expand
      button beside it.
    </p>
    {
      /* No `#controls-from-props` fragment here: ExampleBrowser reads the hash
      as a route rather than scrolling to an element, so the examples page is
      client:only and carries no such id. hyperlink --check-anchors is right to
      call that a broken anchor, and it fails the build. */
    }
    <p>
      That is a react-msaview component in your own page rather than a JBrowse
      session, and the props drive it live, so a toggle costs no remount and no
      refetch. The <a href={`${base}/embedding`}>embedding guide</a> has the recipe,
      and the <strong>Controls from props</strong> entry on the
      <a href={`${base}/examples`}>examples</a> page is it running.
    </p>
  </article>
</Base>
