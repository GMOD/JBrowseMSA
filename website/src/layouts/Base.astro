---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  wide?: boolean
  fullBleed?: boolean
}
const { title, description, wide, fullBleed } = Astro.props
const base = import.meta.env.BASE_URL
const home = { href: base, label: 'Home' }
const demo = { href: `${base}/demo/`, label: 'Demo' }
const groups = [
  {
    label: 'Docs',
    items: [
      { href: `${base}/guide`, label: 'User guide' },
      { href: `${base}/embedding`, label: 'Embedding' },
      { href: `${base}/r-package`, label: 'R package' },
      { href: `${base}/cli`, label: 'CLI' },
    ],
  },
  {
    label: 'Showcase',
    items: [
      { href: `${base}/gallery`, label: 'Gallery' },
      { href: `${base}/examples`, label: 'Examples' },
      { href: `${base}/gene-explorer`, label: 'JBrowse integration' },
    ],
  },
]

const strip = (s: string) => s.replace(/\/$/, '')
const current = strip(Astro.url.pathname)
const isActive = (href: string) => strip(href) === current
const groupActive = (items: { href: string }[]) =>
  items.some(item => isActive(item.href))
const canonical = new URL(Astro.url.pathname, Astro.site).href
const socialImage = new URL(
  `${base}/media/within-protein-conservation.png`,
  Astro.site,
).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%230d233f'/%3E%3Ctext x='8' y='12' font-family='monospace' font-size='11' font-weight='bold' text-anchor='middle' fill='white'%3EM%3C/text%3E%3C/svg%3E"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JBrowseMSA" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body class:list={{ 'app-layout': fullBleed }}>
    <header class="site-header">
      <a class="brand" href={base}>JBrowseMSA</a>
      <nav aria-label="Primary">
        <a
          href={home.href}
          class:list={{ active: isActive(home.href) }}
          aria-current={isActive(home.href) ? 'page' : undefined}
        >
          {home.label}
        </a>
        {
          groups.map(group => {
            const menuId = `nav-menu-${group.label.toLowerCase()}`
            return (
              <div
                class:list={[
                  'nav-group',
                  { active: groupActive(group.items) },
                ]}
              >
                <button
                  type="button"
                  class="nav-group-btn"
                  aria-expanded="false"
                  aria-controls={menuId}
                >
                  {group.label}
                </button>
                <ul class="nav-menu" id={menuId}>
                  {group.items.map(item => (
                    <li>
                      <a
                        href={item.href}
                        class:list={{ active: isActive(item.href) }}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          })
        }
        <a
          href={demo.href}
          class:list={{ active: isActive(demo.href) }}
          aria-current={isActive(demo.href) ? 'page' : undefined}
        >
          {demo.label}
        </a>
      </nav>
      <a
        class="github-icon"
        href="https://github.com/GMOD/JBrowseMSA"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"></a>
    </header>
    <main class:list={{ wide, 'full-bleed': fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>
        react-msaview (JBrowseMSA) ·
        <a href="https://github.com/GMOD/JBrowseMSA">GitHub</a> · part of <a
          href="https://jbrowse.org">JBrowse</a
        >
      </span>
    </footer>
    <script>
      // Button + aria-expanded disclosure (the WAI-ARIA APG pattern for nav
      // dropdowns of links). Only one group opens at a time; clicking outside
      // or pressing Escape closes them. Navigation is a full reload here, so no
      // route-change handling is needed.
      const buttons = [
        ...document.querySelectorAll<HTMLButtonElement>(
          '.site-header .nav-group-btn',
        ),
      ]
      const closeAll = (except?: HTMLButtonElement) =>
        buttons.forEach(b => {
          if (b !== except) {
            b.setAttribute('aria-expanded', 'false')
          }
        })
      buttons.forEach(btn =>
        btn.addEventListener('click', () => {
          const wasOpen = btn.getAttribute('aria-expanded') === 'true'
          closeAll(btn)
          btn.setAttribute('aria-expanded', wasOpen ? 'false' : 'true')
        }),
      )
      document.addEventListener('click', e => {
        if (
          !(e.target instanceof Element) ||
          !e.target.closest('.site-header .nav-group')
        ) {
          closeAll()
        }
      })
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          closeAll()
        }
      })
    </script>
  </body>
</html>
