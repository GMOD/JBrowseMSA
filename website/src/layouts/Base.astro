---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  wide?: boolean
  fullBleed?: boolean
}
const { title, description, wide, fullBleed } = Astro.props
const base = import.meta.env.BASE_URL
const home = { href: base, label: 'Home' }
const demo = { href: `${base}/demo/`, label: 'Demo' }
const groups = [
  {
    label: 'Docs',
    items: [
      { href: `${base}/guide`, label: 'User guide' },
      { href: `${base}/embedding`, label: 'Embedding' },
      { href: `${base}/r-package`, label: 'R package' },
      { href: `${base}/cli`, label: 'CLI' },
    ],
  },
  {
    label: 'Showcase',
    items: [
      { href: `${base}/gallery`, label: 'Gallery' },
      { href: `${base}/examples`, label: 'Examples' },
      { href: `${base}/gene-explorer`, label: 'JBrowse integration' },
    ],
  },
]

const strip = (s: string) => s.replace(/\/$/, '')
const current = strip(Astro.url.pathname)
const isActive = (href: string) => strip(href) === current
const groupActive = (items: { href: string }[]) =>
  items.some(item => isActive(item.href))
const canonical = new URL(Astro.url.pathname, Astro.site).href
const socialImage = new URL(
  `${base}/media/within-protein-conservation.png`,
  Astro.site,
).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%230d233f'/%3E%3Ctext x='8' y='12' font-family='monospace' font-size='11' font-weight='bold' text-anchor='middle' fill='white'%3EM%3C/text%3E%3C/svg%3E"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JBrowseMSA" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body class:list={{ 'app-layout': fullBleed }}>
    <header class="site-header">
      <a class="brand" href={base}>JBrowseMSA</a>
      <nav aria-label="Primary">
        <a
          href={home.href}
          class:list={{ active: isActive(home.href) }}
          aria-current={isActive(home.href) ? 'page' : undefined}
        >
          {home.label}
        </a>
        {
          groups.map(group => {
            const menuId = `nav-menu-${group.label.toLowerCase()}`
            return (
              <div
                class:list={['nav-group', { active: groupActive(group.items) }]}
              >
                <button
                  type="button"
                  class="nav-group-btn"
                  aria-expanded="false"
                  aria-controls={menuId}
                >
                  {group.label}
                </button>
                <ul class="nav-menu" id={menuId}>
                  {group.items.map(item => (
                    <li>
                      <a
                        href={item.href}
                        class:list={{ active: isActive(item.href) }}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          })
        }
        <a
          href={demo.href}
          class:list={{ active: isActive(demo.href) }}
          aria-current={isActive(demo.href) ? 'page' : undefined}
        >
          {demo.label}
        </a>
      </nav>
      <a
        class="github-icon"
        href="https://github.com/GMOD/JBrowseMSA"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"></a>
    </header>
    <main class:list={{ wide, 'full-bleed': fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>
        react-msaview (JBrowseMSA) ·
        <a href="https://github.com/GMOD/JBrowseMSA">GitHub</a> · part of <a
          href="https://jbrowse.org">JBrowse</a
        >
      </span>
    </footer>
    <script>
      // Button + aria-expanded disclosure (the WAI-ARIA APG pattern for nav
      // dropdowns of links), with the keyboard interaction that pattern
      // specifies: arrows/Home/End move among a group's links, Escape closes and
      // restores focus to the button, and tabbing out closes the group. Only one
      // group opens at a time. Navigation is a full reload here, so no
      // route-change handling is needed.
      const buttons = [
        ...document.querySelectorAll<HTMLButtonElement>(
          '.site-header .nav-group-btn',
        ),
      ]
      const isOpen = (btn: HTMLButtonElement) =>
        btn.getAttribute('aria-expanded') === 'true'
      const setOpen = (btn: HTMLButtonElement, open: boolean) => {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false')
      }
      const closeAll = (except?: HTMLButtonElement) => {
        buttons.forEach(b => {
          if (b !== except) {
            setOpen(b, false)
          }
        })
      }
      const open = (btn: HTMLButtonElement) => {
        closeAll(btn)
        setOpen(btn, true)
      }

      buttons.forEach(btn => {
        const group = btn.closest('.nav-group')
        const menuId = btn.getAttribute('aria-controls')
        const links = menuId
          ? [...document.querySelectorAll<HTMLAnchorElement>(`#${menuId} a`)]
          : []

        btn.addEventListener('click', () => {
          if (isOpen(btn)) {
            closeAll()
          } else {
            open(btn)
          }
        })

        if (group instanceof HTMLElement) {
          group.addEventListener('keydown', e => {
            const onButton = document.activeElement === btn
            const i = links.findIndex(link => link === document.activeElement)
            if (e.key === 'ArrowDown') {
              e.preventDefault()
              if (onButton) {
                open(btn)
                links[0]?.focus()
              } else if (i >= 0) {
                links[Math.min(i + 1, links.length - 1)].focus()
              }
            } else if (e.key === 'ArrowUp' && i === 0) {
              e.preventDefault()
              btn.focus()
            } else if (e.key === 'ArrowUp' && i > 0) {
              e.preventDefault()
              links[i - 1].focus()
            } else if (e.key === 'Home' && i >= 0) {
              e.preventDefault()
              links[0].focus()
            } else if (e.key === 'End' && i >= 0) {
              e.preventDefault()
              links[links.length - 1].focus()
            } else if (e.key === 'Escape' && isOpen(btn)) {
              setOpen(btn, false)
              btn.focus()
            }
          })
          // Close once focus leaves the group entirely (e.g. Tab past the last
          // link); relatedTarget is where focus is heading.
          group.addEventListener('focusout', e => {
            const to = e.relatedTarget
            if (!(to instanceof Node) || !group.contains(to)) {
              setOpen(btn, false)
            }
          })
        }
      })

      document.addEventListener('click', e => {
        if (
          !(e.target instanceof Element) ||
          !e.target.closest('.site-header .nav-group')
        ) {
          closeAll()
        }
      })
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          closeAll()
        }
      })
    </script>
  </body>
</html>
